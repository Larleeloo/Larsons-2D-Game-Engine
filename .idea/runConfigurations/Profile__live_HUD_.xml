<component name="ProjectRunConfigurationManager">
  <!--
    Same as the timed run, but draws the readout on screen so the frame cost
    can be watched live. The HUD costs a millisecond or so of the frame it is
    measuring — that cost is timed into its own "overlay" stage and excluded
    from the reported figures, but prefer the timed run for numbers you intend
    to compare across machines.
  -->
  <configuration default="false" name="Profile (live HUD)" type="GradleRunConfiguration" factoryName="Gradle">
    <ExternalSystemSettings>
      <option name="env">
        <map />
      </option>
      <option name="executionName" />
      <option name="externalProjectPath" value="$PROJECT_DIR$" />
      <option name="externalSystemIdString" value="GRADLE" />
      <option name="scriptParameters" value="-Pprofile.hud=true" />
      <option name="taskDescriptions">
        <list />
      </option>
      <option name="taskNames">
        <list>
          <option value="runProfiled" />
        </list>
      </option>
      <option name="vmOptions" />
    </ExternalSystemSettings>
    <ExternalSystemDebugServerProcess>false</ExternalSystemDebugServerProcess>
    <ExternalSystemReattachDebugProcess>true</ExternalSystemReattachDebugProcess>
    <DebugAllEnabled>false</DebugAllEnabled>
    <RunAsTest>false</RunAsTest>
    <method v="2" />
  </configuration>
</component>
